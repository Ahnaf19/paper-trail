# Copy to .env and adjust. `docker compose up` needs nothing else.
#   cp .env.example .env

# --- Database ---------------------------------------------------------------
# These configure the Postgres container itself.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pipeline
POSTGRES_PORT=5432

# This configures the application, which is a separate concern: the server needs
# credentials, the client needs a URL. Inside docker compose the host is `db`;
# from your own machine it is localhost, which is why this default says localhost.
# Keep the user/password/database in sync with the three values above.
DATABASE_URL=postgresql://pipeline:change-me-locally@localhost:5432/pipeline

# --- Logging ----------------------------------------------------------------
# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
