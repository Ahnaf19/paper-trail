# cp .env.example .env  — nothing else is needed for `docker compose up`.

# Postgres container
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pipeline
POSTGRES_PORT=5432

# App connection. Host is `db` inside compose, localhost from your machine.
DATABASE_URL=postgresql://pipeline:change-me-locally@localhost:5432/pipeline

# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
