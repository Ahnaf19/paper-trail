# cp .env.example .env  — nothing else is needed for `docker compose up`.

# Published host port for the API. The container always listens on 8000 — this only
# changes what that is mapped to, so two stacks can run side by side.
API_PORT=8000

# Postgres container
POSTGRES_USER=arxiv
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=arxiv
POSTGRES_PORT=5432

# App connection. Host is `db` inside compose, localhost from your machine.
DATABASE_URL=postgresql://arxiv:change-me-locally@localhost:5432/arxiv

# TRACE | DEBUG | INFO | SUCCESS | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# LLM for POST /ask. Any OpenAI-compatible endpoint; Groq is free and needs no card.
# Get a key at https://console.groq.com/keys
LLM_API_KEY=gsk_your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
# A Groq *production* model as of 15 Sep 2026. The llama-* ids are Enterprise-only.
LLM_MODEL=openai/gpt-oss-20b

# Retrieval. The threshold is calibrated against the corpus — see the README before changing.
RELEVANCE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5

# arXiv client. 3.0 s is the Terms of Use floor and cannot go lower; 2000 is the
# documented page ceiling.
ARXIV_PAGE_SIZE=200
ARXIV_MIN_REQUEST_INTERVAL=3.0
ARXIV_MAX_RETRIES=5
